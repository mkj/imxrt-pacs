#!/bin/bash

set -e

(
  rm -rf pacs/imxrt1011/src
  mkdir -p pacs/imxrt1011/
  cd pacs/imxrt1011/
  chiptool generate --svd ../../svd/MIMXRT1011.svd --transform ../../transforms/common.yaml --transform ../../svd/MIMXRT1011.yaml
  form -i lib.rs -o src
  rm lib.rs
  echo -ne "#![allow(warnings)]\n#![feature(const_mut_refs)]\n$(cat src/lib.rs)" > ./src/lib.rs
  rustfmt ./**/*.rs
)

